# MongoDB connection string (replica set required for transactions). Never commit a real one.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/studyquest?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_URL=http://127.0.0.1:3000
# Two-step sign-in: key material for encrypting authenticator seeds at rest (32+ random characters). Optional; falls back to SESSION_SECRET.
# Set it before launch and never rotate it casually: rotating it makes every enrolled authenticator unusable.
# TWO_FACTOR_KEY=
# Optional local seed account; no default password is supplied.
SEED_EMAIL=
SEED_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional provider adapter; credentials remain on the server.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Phase 5: SaaS billing & operations (all optional) ---
# Razorpay (leave unset to use the clearly-labelled local sandbox in development)
# RAZORPAY_KEY_ID=rzp_test_xxx          # rzp_test_ = gateway test mode (sandbox data), rzp_live_ = production
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=              # webhook URL: {APP_URL}/api/billing/webhook. Different from the key secret, 16+ random characters
# BILLING_EXPECT_MODE=live              # live in production, test in staging: a mismatching key is a configuration error. All three Razorpay variables or none.
#                                       # Live keys are refused unless NODE_ENV=production and APP_URL is https. See docs/BILLING.md
# ALLOW_BILLING_SANDBOX=1               # only to enable the local sandbox in production-mode builds (testing)
# CRON_SECRET=                          # call POST /api/jobs/run with header x-cron-secret for reminders/expiry
# Email (required in production for password reset, owner email verification and billing mail).
# Your provider/relay receives POST {to, subject, text} with headers Content-Type: application/json,
# Idempotency-Key: <uuid> and, if set, Authorization: Bearer <EMAIL_WEBHOOK_TOKEN>. Any 2xx = accepted.
# Must be https:// in production. Without it, reset and verification return 503 instead of pretending to send.
# EMAIL_WEBHOOK_URL=https://<your-email-relay>/send
# EMAIL_WEBHOOK_TOKEN=<random-shared-secret>

# --- Phase 6: production operations ---
# TRUST_PROXY=1                  # only behind a proxy that overwrites X-Forwarded-For
# LOG_LEVEL=info                 # debug | info | warn | error
# ALERT_WEBHOOK_URL=             # HTTPS incoming webhook for alerts (required in production). Deduplicated, storm-limited, with recovery notices: docs/MONITORING.md
# ALERT_API_ERRORS_PER_5MIN=10   # unexpected API errors in 5 minutes before the error-rate alert
# READY_DB_TIMEOUT_MS=3000       # /api/ready database probe timeout
# WORKER_HEARTBEAT_URL=          # dead-man's-switch ping after each successful worker tick (healthchecks-style POST)
# JOB_INTERVAL_MINUTES=15        # worker cadence
# JOBS_MAX_AGE_HOURS=26          # /api/ready reports degraded if no job succeeded within this window
# MONGODB_POOL_SIZE=20

# Web push / phone notifications (optional). Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Database backups (docs/BACKUP_RESTORE.md). Used by the backup job/host ONLY: never give these to the web or worker processes. ---
# BACKUP_SOURCE_URI=            # dedicated READ-ONLY database user (falls back to MONGODB_URI)
# BACKUP_ENCRYPTION_KEYS=k1:<base64 32 random bytes>   # first key encrypts, all keys decrypt. Keep an offline copy: losing it makes every backup unreadable
# BACKUP_S3_BUCKET=             # S3-compatible bucket in a separate failure domain (versioning/object lock on)
# BACKUP_S3_REGION=
# BACKUP_S3_ENDPOINT=           # only for R2 / B2 / MinIO
# BACKUP_S3_PREFIX=studyquest/
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_DIR=                   # only a mounted OFF-SITE volume, or drills; ignored when BACKUP_S3_BUCKET is set
# BACKUP_RETENTION_DAYS=35
# BACKUP_RETENTION_MONTHS=12
# BACKUP_MAX_AGE_HOURS=26       # check alerts when the newest backup is older
# BACKUP_HEARTBEAT_URL=        # dead-man's-switch pinged after each successful daily backup ("<url>/fail" after a failure)
# BACKUP_CHECK_HEARTBEAT_URL=  # same for the weekly deep integrity check
# BACKUP_PROTECTED_TARGETS=     # extra databases a restore must never target, separated by ";"
# Restore (set only for the restore run): RESTORE_TARGET_URI=<NEW empty database uri>
