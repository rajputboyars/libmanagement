{
  "name": "studyquest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "migrate:orgs": "node --env-file=.env.local --import tsx scripts/migrate-orgs.ts",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "backup": "node --env-file=.env.local --import tsx scripts/backup.ts backup",
    "restore": "node --env-file=.env.local --import tsx scripts/backup.ts restore",
    "bootstrap-admin": "node --env-file=.env.local --import tsx scripts/bootstrap-admin.ts",
    "test:integration": "tsx scripts/test-db.ts",
    "test:http": "tsx scripts/test-http.ts",
    "format": "prettier --write src scripts tests"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "motion": "^12.23.0",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.3.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
